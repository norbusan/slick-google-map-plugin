{
	"name": "sgmp/slick-google-map",
	"description": "Slick Google Map WordPress plugin",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"brain/monkey": "^2.6",
		"mockery/mockery": "^1.6",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"SGMP\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SGMP\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"readme": "php bin/generate-readme.php"
	},
	"config": {
		"sort-packages": true
	}
}
